# LLM 摘要（可选）。不配置时，新条目保留英文摘要；页面仍可使用。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 飞书自定义机器人 webhook（可选）。配置后，Actions 每天推送一张日报卡片。
FEISHU_WEBHOOK=

# Telegram（可选）。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub Search API（可选，Actions 自带 GITHUB_TOKEN 时通常不需要单独设置）。
GITHUB_TOKEN=
