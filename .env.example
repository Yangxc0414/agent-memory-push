# LLM 摘要（可选）。当前默认接 Agnes 3.0 Flash。
# 不配置时，新条目保留英文摘要；页面仍可使用。
LLM_BASE_URL=https://api.agnes-ai.cn/v1
LLM_API_KEY=
LLM_MODEL=agnes-3.0-flash
# 每次最多合并多少条新内容（默认 24，避免一次 arXiv 拉取把页面撑爆）。
MAX_NEW_ITEMS=24

# 飞书自定义机器人 webhook（可选）。配置后，Actions 每天推送一张日报卡片。
FEISHU_WEBHOOK=

# Telegram（可选）。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy 真实推送（可选，无需账号）。设置一个随机 topic 后，Actions 每天向该 topic 发布日报。
# 手机安装 ntfy app 或打开 https://ntfy.sh/<topic> 即可订阅。
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# GitHub Search API（可选，Actions 自带 GITHUB_TOKEN 时通常不需要单独设置）。
GITHUB_TOKEN=
