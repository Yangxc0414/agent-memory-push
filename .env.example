# LLM 摘要（可选）。当前默认接 Agnes 3.0 Flash。
# 不配置时，新条目保留英文摘要；页面仍可使用。
LLM_BASE_URL=https://api.agnes-ai.cn/v1
LLM_API_KEY=
LLM_MODEL=agnes-3.0-flash
# arXiv 检索窗口：窗口内的相关结果会一直翻页取完，不再按条数或主题配额截断。
ARXIV_LOOKBACK_DAYS=14
# 安全上限：单个查询最多翻多少页；正常情况下窗口结束后会提前停止。
ARXIV_MAX_PAGES=12
ARXIV_PAGE_SIZE=100
ARXIV_PAGE_DELAY_MS=3000

# 每次运行最多给多少条最新内容补中文标题、摘要与推送理由，避免一次重采调用过久。
LLM_ENRICH_LIMIT=60

# 日报分栏最多容纳多少条；默认 120，更多内容仍在“全部动态”里。
DIGEST_SECTION_LIMIT=120

# 飞书自定义机器人 webhook（可选）。配置后，Actions 每天推送一张日报卡片。
FEISHU_WEBHOOK=

# Telegram（可选）。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy 真实推送（可选，无需账号）。设置一个随机 topic 后，Actions 每天向该 topic 发布日报。
# 手机安装 ntfy app 或打开 https://ntfy.sh/<topic> 即可订阅。
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# GitHub Search API（可选，Actions 自带 GITHUB_TOKEN 时通常不需要单独设置）。
GITHUB_TOKEN=
